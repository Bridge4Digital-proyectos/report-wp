# Copia este archivo como ".env" (en la misma carpeta) y completa los valores.
# El archivo .env tiene claves: no lo compartas ni lo subas a ningún lado.

# Clave secreta de Django: una cadena larga y aleatoria (iniciar.bat genera una si falta el .env).
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Contraseña de la base PostgreSQL (solo la usa la app; elige cualquiera larga).
POSTGRES_PASSWORD=cambia-esta-contrasena

# Direcciones desde las que se abre la app. Para usarla desde otra PC de la red, agrega la IP de este equipo
# (ej. 192.168.1.50) aquí y en CSRF_TRUSTED_ORIGINS, y cambia PUERTO a 8010.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
PUERTO=127.0.0.1:8010

# Hora diaria en que se traen los reportes de Connectly (formato 24 h).
SINCRONIZAR_HORA=07:00
TIME_ZONE=America/La_Paz

# API keys de Connectly: una variable por cuenta. En el admin (Cuentas de Connectly) se indica el
# Business ID y el NOMBRE de la variable (por ejemplo CONNECTLY_API_KEY_TIGO). La clave solo vive aquí.
CONNECTLY_API_KEY_TIGO=

# Solo para desarrollo (runserver): 1 muestra errores detallados. En Docker déjalo en 0.
DEBUG=0
